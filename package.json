{
  "name": "meowkit-companion-application",
  "version": "0.1.0",
  "private": true,
  "description": "MeowKit Companion App + MeowKitIDE (offline serial + flash)",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/ensure-vendor.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fetch-firmware": "node scripts/fetch-firmware.mjs",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "dependencies": {
    "@meowkit/components": "workspace:*",
    "@meowkit/global-styles": "workspace:*",
    "@meowkit/design-tokens": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "electron-updater": "^6.3.9",
    "esptool-js": "^0.5.7",
    "monaco-editor": "^0.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-vite": "^3.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.0"
  }
}
